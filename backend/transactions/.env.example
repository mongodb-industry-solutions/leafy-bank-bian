# Template for backend/transactions/.env — copy and fill in. Never commit real values.
MONGODB_URI=
LEAFYBANK_DB_NAME=leafy_bank_bian
PAYMENT_LIMIT_USD=1000000
PARTY_AUTH_SECRET=

# Cut-off release janitor: releases CUTOFF-DEMO- runs a presenter abandoned. Keep OFF locally
# (the database is shared, so a local janitor would release a live presenter's run); on in
# staging-dev only.
ENABLE_CUTOFF_RELEASE_JANITOR=false
CUTOFF_RELEASE_AFTER_SECONDS=1200
