# Payment Agent service env. Copy to `.env` and fill from the shared values.
# Only this service needs VOYAGE_API_KEY (it owns the semantic embedder).
MONGODB_URI=
LEAFYBANK_DB_NAME=fsi-bian-test-db
VOYAGE_API_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
PORT=8004
# Cutoff Agent worker (payments status stream + sweep). Default OFF; keep OFF on staging-dev.
ENABLE_CUTOFF_AGENT=false
CUTOFF_AGENT_SWEEP_SECONDS=30
