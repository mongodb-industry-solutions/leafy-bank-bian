FROM node:22-alpine
WORKDIR /app
COPY bian-model/package*.json ./
# Use legacy-peer-deps for LeafyGreen UI components
RUN npm install --legacy-peer-deps
COPY bian-model/ .
RUN npm run build
# Kanopy requires port 8080
ENV PORT=8080
EXPOSE 8080
# Start Next.js on port 8080
CMD ["npm", "start", "--", "-p", "8080"]
